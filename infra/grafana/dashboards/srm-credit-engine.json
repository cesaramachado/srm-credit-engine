{
  "id": null,
  "uid": "srm-credit-engine",
  "title": "SRM Credit Engine",
  "tags": ["srm", "credit-engine"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requisições HTTP por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"srm-credit-engine\"}[5m]))", "legendFormat": "req/s", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Latência HTTP p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"srm-credit-engine\"}[5m])))", "legendFormat": "{{uri}}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Heap JVM utilizado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{application=\"srm-credit-engine\", area=\"heap\"})", "legendFormat": "heap usado", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Pausas do Garbage Collector por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(jvm_gc_pause_seconds_count{application=\"srm-credit-engine\"}[5m]))", "legendFormat": "pausas/s", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Conexões ativas do pool JDBC",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "hikaricp_connections_active{application=\"srm-credit-engine\"}", "legendFormat": "{{pool}}", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Duração das simulações de preço (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(srm_pricing_calculations_seconds_bucket[5m])))", "legendFormat": "{{outcome}}", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "Redis: memória utilizada",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "memória", "refId": "A" }]
    },
    {
      "id": 8,
      "title": "Redis: comandos por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "comandos/s", "refId": "A" }]
    }
  ]
}
