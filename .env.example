# Copie para .env e gere valores locais antes de iniciar o Compose.
# DB_NAME, DB_USERNAME e os identificadores do Keycloak devem ser simples.
# Senhas SQL Server, Redis e Keycloak devem conter somente letras e números.
MSSQL_SA_PASSWORD=ReplaceWithRandomAlphaNumericPassword123456789
DB_NAME=srm_credit_engine
DB_USERNAME=credit_engine_app
DB_PASSWORD=ReplaceWithRandomAlphaNumericPassword123456789

REDIS_PASSWORD=ReplaceWithRandomAlphaNumericPassword123456789
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=ReplaceWithRandomAlphaNumericPassword123456789
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=ReplaceWithRandomAlphaNumericPassword123456789
KEYCLOAK_PUBLIC_URL=http://localhost:18180

ACTUATOR_METRICS_USERNAME=metrics
ACTUATOR_METRICS_PASSWORD=ReplaceWithRandomAlphaNumericPassword123456789
GRAYLOG_PASSWORD_SECRET=ReplaceWithRandomAlphaNumericPassword12345678901234567890123456789012
# SHA-256 hexadecimal of the password chosen for the local Graylog administrator.
GRAYLOG_ROOT_PASSWORD_SHA2=REPLACE_WITH_SHA256_HEX_OF_GRAYLOG_ADMIN_PASSWORD
GRAYLOG_PUBLIC_URL=http://localhost:19000/
GRAFANA_ADMIN_PASSWORD=ReplaceWithGrafanaPassword123456

SQLSERVER_HOST_PORT=11433
REDIS_HOST_PORT=16379
KEYCLOAK_HOST_PORT=18180
APP_HOST_PORT=18080
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
GRAYLOG_HOST_PORT=19000
GRAYLOG_GELF_UDP_HOST_PORT=12202
